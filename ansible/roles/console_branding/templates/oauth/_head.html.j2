<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ page_title }} · {{ console_product_name }}</title>
    <style type="text/css">
      :root { --primary: {{ event_color_primary }}; --accent: {{ event_color_accent }}; }
      * { box-sizing: border-box; }
      body {
        margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center;
        font-family: "Red Hat Text", "Open Sans", Helvetica, Arial, sans-serif; font-size: 15px;
        background: radial-gradient(circle at 20% 10%, #0b3aa0 0%, var(--primary) 55%, #00143f 100%);
        color: #1b1d21; padding: 16px;
      }
      .card {
        width: 100%; max-width: 420px; background: #fff; border-radius: 14px;
        border-top: 6px solid var(--accent); box-shadow: 0 20px 50px rgba(0,0,0,.35);
        padding: 28px 32px 32px; text-align: center;
      }
      .badge { width: 132px; height: 132px; border-radius: 50%; margin: 0 auto 12px; display: block; }
      h1 { font-size: 21px; margin: 4px 0 2px; color: var(--primary); }
      .tagline { margin: 0 0 4px; color: #4d5258; }
      .product { margin: 0 0 22px; font-size: 13px; color: var(--accent); font-weight: 600; letter-spacing: .03em; text-transform: uppercase; }
      form { text-align: left; }
      label { display: block; font-weight: 600; margin: 10px 0 4px; }
      input[type=text], input[type=password] {
        width: 100%; padding: 10px 12px; border: 1px solid #c7c7c7; border-radius: 6px; font-size: 15px;
      }
      input:focus { outline: 2px solid var(--accent); border-color: var(--accent); }
      button, .provider a {
        display: block; width: 100%; margin-top: 18px; padding: 11px; border: 0; border-radius: 6px;
        background: var(--accent); color: #fff; font-size: 16px; font-weight: 700; cursor: pointer;
        text-decoration: none; text-align: center;
      }
      button:hover, .provider a:hover { background: #e05a00; }
      .error { background: #fdecea; color: #a30000; border-radius: 6px; padding: 10px; margin-bottom: 10px; text-align: left; }
      .footer { margin-top: 18px; font-size: 12px; color: #6a6e73; }
      .footer a { color: var(--primary); }
    </style>
  </head>
  <body>
    <main class="card">
      <img class="badge" alt="{{ event_name }}" src="data:image/png;base64,{{ cb_badge.content }}">
      <h1>{{ event_name }}</h1>
      <p class="tagline">{{ event_tagline }}</p>
      <p class="product">{{ console_product_name }}</p>
