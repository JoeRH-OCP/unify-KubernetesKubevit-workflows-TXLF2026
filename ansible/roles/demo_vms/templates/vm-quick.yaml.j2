apiVersion: kubevirt.io/v1
kind: VirtualMachine
metadata:
  name: vm-quick
  namespace: {{ demo_namespace }}
  labels:
    app.kubernetes.io/component: vm-quick
    {{ event_labels | to_nice_yaml(indent=2) | indent(4) }}
spec:
  runStrategy: Always
  template:
    metadata:
      labels:
        app.kubernetes.io/component: vm-quick
        {{ event_labels | to_nice_yaml(indent=2) | indent(8) }}
    spec:
      domain:
        cpu:
          cores: {{ vm_cpu_cores }}
          sockets: 1
          threads: 1
        # kubevirt-manager reads cpu cores/sockets/threads and resources.requests.memory
        resources:
          requests:
            memory: {{ vm_memory }}
        devices:
          disks:
            - name: containerdisk
              disk:
                bus: virtio
            - name: cloudinit
              disk:
                bus: virtio
          interfaces:
            - name: default
              masquerade: {}
          rng: {}
      networks:
        - name: default
          pod: {}
      terminationGracePeriodSeconds: 30
      volumes:
        - name: containerdisk
          containerDisk:
            image: {{ demo_containerdisk_image }}
        - name: cloudinit
          cloudInitNoCloud:
            secretRef:
              name: vm-quick-cloudinit
