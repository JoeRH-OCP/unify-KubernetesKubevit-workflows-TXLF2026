# Based on kubernetes/deployment.yaml from kubevirt-manager v{{ kubevirt_manager_version }}.
# Changes: pinned image, no fixed runAsUser/runAsGroup (OpenShift restricted-v2
# assigns one), our nginx default.conf and the event branding.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: kubevirt-manager
  namespace: {{ kubevirt_manager_namespace }}
  labels:
    app: kubevirt-manager
    kubevirt-manager.io/version: "{{ kubevirt_manager_version }}"
    {{ event_labels | to_nice_yaml(indent=2) | indent(4) }}
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: kubevirt-manager
  template:
    metadata:
      labels:
        app: kubevirt-manager
        kubevirt-manager.io/version: "{{ kubevirt_manager_version }}"
        {{ event_labels | to_nice_yaml(indent=2) | indent(8) }}
      annotations:
        {{ event_slug }}/config-checksum: "{{ kvm_config_checksum }}"
    spec:
      serviceAccountName: kubevirt-manager
      restartPolicy: Always
      securityContext:
        runAsNonRoot: true
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: kubevirtmgr
          image: {{ kubevirt_manager_image }}
          imagePullPolicy: IfNotPresent
          ports:
            - name: http
              containerPort: 8080
          readinessProbe:
            tcpSocket:
              port: 8080
            periodSeconds: 10
          resources:
            requests:
              cpu: 50m
              memory: 128Mi
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: ["ALL"]
          volumeMounts:
            - name: cache-volume
              mountPath: /var/cache/nginx
            - name: run-volume
              mountPath: /var/run
            - name: nginx-conf
              mountPath: /etc/nginx/conf.d/default.conf
              subPath: default.conf
            - name: branding
              mountPath: /usr/share/nginx/html/assets/txlf
            - name: branding
              mountPath: /usr/share/nginx/html/assets/logo-transparent.png
              subPath: logo.png
            - name: oauth-config
              mountPath: /etc/nginx/oauth.d/
            - name: auth-config
              mountPath: /etc/nginx/auth.d/
            - name: auth-secret
              mountPath: /etc/nginx/secret.d/
            # Our metrics location (Secret: it carries a read-only token).
            - name: prometheus-config
              mountPath: /etc/nginx/location.d/
            - name: service-ca
              mountPath: /etc/nginx/service-ca/
      volumes:
        - name: cache-volume
          emptyDir: {}
        - name: run-volume
          emptyDir: {}
        - name: nginx-conf
          configMap:
            name: kubevirt-manager-nginx
        - name: branding
          configMap:
            name: kubevirt-manager-branding
        - name: oauth-config
          configMap:
            name: oauth-config
            optional: true
        - name: auth-config
          configMap:
            name: auth-config
        - name: auth-secret
          secret:
            secretName: auth-secret
        - name: prometheus-config
          secret:
            secretName: kubevirt-manager-prometheus
            optional: true
        - name: service-ca
          configMap:
            name: kubevirt-manager-service-ca
            optional: true
