# Metrics for the kubevirt-manager VM graphs ({{ kvm_metrics_mode }} backend).
# Only the two read-only query endpoints the UI uses, behind basic auth.
location ~ ^/api/v1/(query|query_range)$ {
    include /etc/nginx/auth.d/*.conf;
    limit_except GET { deny all; }
{% if kvm_metrics_mode == 'thanos' %}
    proxy_set_header Authorization "Bearer {{ kvm_metrics_token }}";
    proxy_ssl_trusted_certificate /etc/nginx/service-ca/service-ca.crt;
    proxy_ssl_verify on;
    proxy_ssl_verify_depth 2;
    proxy_ssl_server_name on;
    proxy_ssl_name {{ kubevirt_manager_thanos_service }}.{{ kubevirt_manager_thanos_namespace }}.svc;
    proxy_http_version 1.1;
    proxy_pass https://{{ kubevirt_manager_thanos_service }}.{{ kubevirt_manager_thanos_namespace }}.svc:{{ kubevirt_manager_thanos_port }};
{% else %}
    proxy_set_header Authorization "";
    proxy_http_version 1.1;
    proxy_pass {{ kubevirt_manager_prometheus_url }};
{% endif %}
}
